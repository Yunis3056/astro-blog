---
import { SITE_TITLE } from '../consts';
const today = new Date();
---

<footer>
	<div class="inner">
		<div class="brand-block">
			<p class="mark">{SITE_TITLE}</p>
			<p class="tagline">在这里慢慢写。</p>
		</div>
		<div class="links">
			<a href="/topics" class="magnetic" data-magnetic="0.25">专题</a>
			<a href="/series" class="magnetic" data-magnetic="0.25">系列</a>
			<a href="/blog" class="magnetic" data-magnetic="0.25">文章</a>
			<a href="/projects" class="magnetic" data-magnetic="0.25">项目</a>
			<a href="/notes" class="magnetic" data-magnetic="0.25">笔记</a>
			<a href="/rss.xml" class="magnetic" data-magnetic="0.25">RSS</a>
			<a href="https://github.com/Yunis3056/astro-blog" class="magnetic" data-magnetic="0.25" target="_blank" rel="noreferrer">GitHub</a>
		</div>
	</div>
	<div class="bottom">
		<span>© {today.getFullYear()} — Crafted with Astro.</span>
		<span class="dot-sep">·</span>
		<span>All rights reserved.</span>
	</div>
</footer>

<style>
	footer {
		position: relative;
		margin-top: 6rem;
		padding: 5rem 2rem 3rem;
		border-top: 1px solid rgb(var(--line));
		color: rgb(var(--ink-soft));
	}
	.inner {
		max-width: var(--container);
		margin: 0 auto;
		display: flex; align-items: flex-start; justify-content: space-between;
		gap: 2rem; flex-wrap: wrap;
	}
	.mark {
		font-family: var(--font-display);
		font-size: 1.6rem; margin: 0;
		color: rgb(var(--ink));
		letter-spacing: -0.01em;
	}
	.tagline { color: rgb(var(--muted)); margin: 0.4rem 0 0; font-size: 0.9rem; }
	.links {
		display: flex; flex-wrap: wrap; gap: 0.4rem 1.6rem;
		font-size: 0.9rem;
	}
	.links a { color: rgb(var(--ink-soft)); }
	.links a:hover { color: rgb(var(--accent)); }
	.bottom {
		max-width: var(--container);
		margin: 4rem auto 0;
		padding-top: 1.5rem;
		border-top: 1px solid rgba(var(--line), 0.7);
		font-size: 0.78rem; color: rgb(var(--muted));
		letter-spacing: 0.05em;
		display: flex; gap: 0.6rem; flex-wrap: wrap;
	}
	.dot-sep { opacity: 0.5; }
</style>
