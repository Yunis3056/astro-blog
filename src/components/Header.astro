---
import { SITE_TITLE } from '../consts';
import HeaderLink from './HeaderLink.astro';
---

<header>
	<nav aria-label="主导航">
		<a class="brand magnetic" href="/" data-magnetic="0.25">
			<span class="dot"></span>
			<span>{SITE_TITLE}</span>
		</a>
		<div class="internal-links">
			<HeaderLink href="/">首页</HeaderLink>
			<HeaderLink href="/blog">文章</HeaderLink>
			<HeaderLink href="/projects">项目</HeaderLink>
			<HeaderLink href="/notes">笔记</HeaderLink>
			<HeaderLink href="/about">关于</HeaderLink>
		</div>
		<a class="repo-link magnetic" href="https://github.com/Yunis3056/astro-blog" target="_blank" rel="noreferrer" data-magnetic="0.25">
			GitHub
			<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M7 17 17 7M9 7h8v8"/></svg>
		</a>
	</nav>
</header>

<style>
	header {
		position: sticky; top: 0; z-index: 100;
		padding: 0 2rem;
		background: rgba(var(--bg), 0.65);
		backdrop-filter: saturate(180%) blur(16px);
		-webkit-backdrop-filter: saturate(180%) blur(16px);
		border-bottom: 1px solid rgba(var(--line), 0.6);
	}
	nav {
		display: flex; align-items: center; justify-content: space-between;
		gap: 1.5rem; min-height: 64px;
		max-width: var(--container);
		margin: 0 auto;
	}
	.brand {
		display: inline-flex; align-items: center; gap: 0.6rem;
		font-family: var(--font-display);
		font-size: 1.05rem; font-weight: 500;
		letter-spacing: -0.01em;
		color: rgb(var(--ink));
	}
	.brand .dot {
		width: 8px; height: 8px; border-radius: 50%;
		background: rgb(var(--accent));
		box-shadow: 0 0 12px rgba(var(--accent), 0.7);
		animation: pulse 2.4s ease-in-out infinite;
	}
	@keyframes pulse {
		0%,100% { transform: scale(1); opacity: 1; }
		50% { transform: scale(1.25); opacity: 0.7; }
	}
	.internal-links {
		display: flex; align-items: center; gap: 0.25rem;
	}
	.internal-links :global(a) {
		position: relative;
		padding: 0.5rem 0.9rem;
		font-size: 0.88rem;
		color: rgb(var(--ink-soft));
		border-radius: 999px;
		transition: color 0.3s var(--ease), background 0.3s var(--ease);
	}
	.internal-links :global(a:hover) {
		color: rgb(var(--ink));
		background: rgba(var(--ink), 0.05);
	}
	.internal-links :global(a.active) {
		color: rgb(var(--ink));
		background: rgba(var(--ink), 0.08);
		font-weight: 500;
	}
	.repo-link {
		display: inline-flex; align-items: center; gap: 0.4rem;
		font-size: 0.85rem; color: rgb(var(--ink-soft));
	}
	.repo-link:hover { color: rgb(var(--accent)); }

	@media (max-width: 820px) {
		header { padding: 0 1rem; }
		nav { flex-wrap: wrap; min-height: 0; padding: 0.8rem 0; }
		.internal-links { order: 3; width: 100%; overflow-x: auto; justify-content: flex-start; -ms-overflow-style: none; scrollbar-width: none; }
		.internal-links::-webkit-scrollbar { display: none; }
	}
</style>
