---
interface Props { tags: string[]; counts?: Record<string, number>; size?: 'sm' | 'md' | 'lg'; }
const { tags, counts = {}, size = 'md' } = Astro.props;
---
<ul class={`tag-list ${size}`}>
	{tags.map((t) => {
		const count = counts[t];
		return (
			<li>
				<a
					href={`/tags/${encodeURIComponent(t)}/`}
					class="tag"
					aria-label={count ? `查看 ${t} 标签下的 ${count} 篇文章` : `查看 ${t} 标签`}
				>
					<span class="name">{t}</span>
					{count && <span class="count">{count}</span>}
				</a>
			</li>
		);
	})}
</ul>

<style>
	.tag-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: flex;
		flex-wrap: wrap;
		gap: 0.72rem;
	}
	.tag {
		display: inline-flex;
		align-items: center;
		gap: 0.42rem;
		min-height: 32px;
		padding: 0.32rem 0.78rem;
		font-size: 0.86rem;
		font-weight: 700;
		line-height: 1;
		color: rgb(var(--accent));
		background: rgba(var(--accent-soft), 0.16);
		border: 1px solid rgba(var(--accent-soft), 0.16);
		border-radius: 999px;
		transition:
			color .25s var(--ease),
			background .25s var(--ease),
			border-color .25s var(--ease),
			transform .25s var(--ease);
	}
	.name { white-space: nowrap; }
	.count {
		font-family: var(--font-mono);
		font-size: 0.85em;
		font-weight: 700;
		color: rgb(var(--ink-soft));
	}
	.tag:hover {
		color: rgb(var(--bg));
		background: rgb(var(--accent));
		border-color: rgb(var(--accent));
		transform: translateY(-1px);
	}
	.tag:hover .count {
		color: rgb(var(--bg));
	}
	:global([data-theme="dark"]) .tag {
		background: rgba(var(--accent), 0.13);
		border-color: rgba(var(--accent), 0.18);
	}
	.tag-list.sm { gap: 0.4rem; }
	.tag-list.sm .tag {
		min-height: 22px;
		padding: 0.12rem 0.52rem;
		font-size: 0.7rem;
	}
	.tag-list.sm .count { display: none; }
	.tag-list.lg {
		gap: 0.78rem 0.9rem;
	}
	.tag-list.lg .tag {
		min-height: 40px;
		padding: 0.42rem 0.95rem;
		font-size: 0.95rem;
	}
</style>
