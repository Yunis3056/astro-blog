---
import { Image } from 'astro:assets';
import AboutHeroImage from '../assets/blog-placeholder-about.jpg';
import BaseHead from '../components/BaseHead.astro';
import Effects from '../components/Effects.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { getSiteSettings } from '../lib/content';

export const prerender = true;

const settings = await getSiteSettings();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`关于 · ${settings.title}`} description="关于 Yunis 的博客和站点规划。" image={AboutHeroImage} siteTitle={settings.title} />
	</head>
	<body>
		<Effects />
		<Header siteTitle={settings.title} />
		<main>
			<section class="hero">
				<p class="eyebrow reveal">关于</p>
				<h1 class="reveal" style="--reveal-delay: 100ms">一个慢慢长大的<em>中文博客</em>。</h1>
				<p class="lede reveal" style="--reveal-delay: 220ms">
					这里记录开发过程、学习路线、项目复盘和一些日常思考。内容尽量具体：问题是什么、怎么判断、最后怎么解决。
				</p>
			</section>

			<section class="about-grid">
				<div class="copy reveal">
					<h2>站点</h2>
					<p>前台使用 Astro，内容由 Sanity 在线管理。文章、笔记、项目、专题和系列都可以在后台写作、预览和发布。</p>
					<h2>写作原则</h2>
					<p>少写空话，多留下可复用的判断依据和操作步骤。每篇尽量回答一个具体问题。</p>
					<h2>方向</h2>
					<p>Web 开发、自动化工具、产品实践、学习笔记。</p>
				</div>
				<div class="visual reveal" style="--reveal-delay: 200ms" data-tilt="6">
					<div class="frame">
						<Image width={720} height={540} src={AboutHeroImage} alt="博客关于页配图" />
					</div>
					<div class="card-info">
						<p><strong>仓库</strong></p>
						<p><a href="https://github.com/Yunis3056/astro-blog" target="_blank" rel="noreferrer">Yunis3056/astro-blog →</a></p>
					</div>
				</div>
			</section>
		</main>
		<Footer siteTitle={settings.title} />
	</body>
</html>

<style>
	.hero { padding: 2rem 0 4rem; max-width: 760px; }
	.hero h1 em { font-style: italic; color: rgb(var(--accent)); }
	.lede { font-size: 1.1rem; color: rgb(var(--ink-soft)); }
	.about-grid {
		display: grid;
		grid-template-columns: minmax(0, 1.1fr) minmax(280px, 0.9fr);
		gap: 4rem;
		align-items: start;
	}
	.copy h2 { font-size: 1.3rem; margin: 2rem 0 0.6rem; }
	.copy h2:first-child { margin-top: 0; }
	.copy p { color: rgb(var(--ink-soft)); }
	.visual { transition: transform 0.5s var(--ease-out); will-change: transform; }
	.frame {
		overflow: hidden;
		border-radius: var(--radius);
		border: 1px solid rgb(var(--line));
		background: rgb(var(--bg-soft));
	}
	.frame img {
		display: block; width: 100%; height: auto;
		filter: saturate(0.85);
		transition: filter 0.6s var(--ease), transform 0.7s var(--ease-out);
	}
	.visual:hover .frame img { filter: saturate(1.05); transform: scale(1.03); }
	.card-info {
		padding: 1.2rem 1.4rem; margin-top: 1rem;
		border: 1px solid rgb(var(--line));
		border-radius: var(--radius-sm);
		background: rgba(var(--bg-soft), 0.6);
		font-size: 0.9rem;
	}
	.card-info p { margin: 0; }
	.card-info p + p { margin-top: 0.35rem; color: rgb(var(--ink-soft)); }
	@media (max-width: 820px) {
		.about-grid { grid-template-columns: 1fr; gap: 2rem; }
	}
</style>
