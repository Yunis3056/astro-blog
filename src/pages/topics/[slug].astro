---
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../../components/BaseHead.astro';
import Effects from '../../components/Effects.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { SITE_TITLE } from '../../consts';
import {
	entriesForTopic,
	getPublicTopics,
	getSearchableEntries,
	hrefForEntry,
	labelForEntry,
	type SearchableEntry,
} from '../../lib/content';

export async function getStaticPaths() {
	const [topics, entries] = await Promise.all([getPublicTopics(), getSearchableEntries()]);
	return topics.map((topic) => ({
		params: { slug: topic.id },
		props: { topic, entries: entriesForTopic(entries, topic.id) },
	}));
}

const { topic, entries } = Astro.props as {
	topic: CollectionEntry<'topics'>;
	entries: SearchableEntry[];
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`${topic.data.title} — 专题 — ${SITE_TITLE}`} description={topic.data.description} />
	</head>
	<body>
		<Effects />
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow reveal"><a href="/topics/">← 返回专题</a></p>
				<h1 class="reveal" style="--reveal-delay: 100ms">{topic.data.title}</h1>
				<p class="lede reveal" style="--reveal-delay: 200ms">{topic.data.description}</p>
			</section>

			<section class="content-list">
				{entries.map((entry, index) => (
					<a class="row reveal" href={hrefForEntry(entry)} style={`--reveal-delay: ${index * 70}ms`}>
						<span class="type">{labelForEntry(entry)}</span>
						<div>
							<h2>{entry.data.title}</h2>
							<p>{entry.data.description}</p>
						</div>
						<span class="date">
							{'pubDate' in entry.data ? <FormattedDate date={entry.data.pubDate} /> : '项目'}
						</span>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero { padding: 2rem 0 4rem; max-width: 760px; }
	.lede { font-size: 1.08rem; color: rgb(var(--ink-soft)); }
	.content-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid rgb(var(--line));
	}
	.row {
		display: grid;
		grid-template-columns: 90px minmax(0, 1fr) 120px;
		gap: 1.2rem;
		align-items: center;
		padding: 1.25rem 0.4rem;
		border-bottom: 1px solid rgb(var(--line));
		color: rgb(var(--ink));
	}
	.row:hover h2 { color: rgb(var(--accent)); }
	.type, .date {
		font-family: var(--font-mono);
		font-size: 0.74rem;
		color: rgb(var(--muted));
	}
	.date { text-align: right; }
	.row h2 { margin: 0 0 0.35rem; font-size: 1.25rem; transition: color 0.3s var(--ease); }
	.row p { margin: 0; font-size: 0.9rem; color: rgb(var(--ink-soft)); }
	@media (max-width: 720px) {
		.row { grid-template-columns: 1fr; gap: 0.45rem; }
		.date { text-align: left; }
	}
</style>
