---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Effects from '../components/Effects.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';

const latestPosts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);

const sections = [
	{ title: '文章', description: '沉淀开发经验、工具使用、项目复盘与学习路线。', href: '/blog', num: '01' },
	{ title: '项目', description: '记录正在做或计划中的作品、目标与技术取舍。', href: '/projects', num: '02' },
	{ title: '笔记', description: '保存短想法、资料索引、待验证的问题与日常清单。', href: '/notes', num: '03' },
];
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Effects />
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow reveal">个人空间 · 自 2025</p>
				<h1 class="reveal" style="--reveal-delay: 100ms">
					慢一点。<br>
					<em>写</em>下来。
				</h1>
				<p class="lede reveal" style="--reveal-delay: 220ms">
					{SITE_DESCRIPTION} 这里不追求频率，只留下值得回头看的内容——开发、学习、项目，以及那些被反复琢磨过的判断。
				</p>
				<div class="actions reveal" style="--reveal-delay: 340ms">
					<a href="/blog" class="btn">
						阅读文章
						<span class="arrow">→</span>
					</a>
					<a href="/about" class="btn ghost">关于我</a>
				</div>
				<div class="scroll-hint" aria-hidden="true">
					<span>SCROLL</span>
					<span class="line"></span>
				</div>
			</section>

			<section class="latest reveal">
				<header class="section-header">
					<div>
						<p class="eyebrow">最近</p>
						<h2>近期写作</h2>
					</div>
					<a href="/blog" class="link-arrow">查看全部 <span class="arrow">→</span></a>
				</header>
				<div class="post-list">
					{latestPosts.map((post, i) => (
						<a class="post-card spotlight reveal" href={`/blog/${post.id}/`} style={`--reveal-delay: ${i * 120}ms`}>
							<div class="num">{String(i + 1).padStart(2, '0')}</div>
							<div class="post-meta"><FormattedDate date={post.data.pubDate} /></div>
							<h3 class="post-title">{post.data.title}</h3>
							<p class="post-desc">{post.data.description}</p>
							<span class="read">阅读 <span class="arrow">→</span></span>
						</a>
					))}
				</div>
			</section>

			<section class="nav-cards reveal">
				<header class="section-header">
					<div>
						<p class="eyebrow">索引</p>
						<h2>站点内容</h2>
					</div>
				</header>
				<div class="nav-grid">
					{sections.map((s, i) => (
						<a class="nav-card spotlight reveal" href={s.href} style={`--reveal-delay: ${i * 120}ms`} data-tilt="4">
							<span class="big-num">{s.num}</span>
							<h3>{s.title}</h3>
							<p>{s.description}</p>
							<span class="link-arrow">进入 <span class="arrow">→</span></span>
						</a>
					))}
				</div>
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		min-height: 75vh;
		display: flex; flex-direction: column; justify-content: center;
		padding: 4rem 0 6rem;
		position: relative;
	}
	.hero h1 em {
		font-style: italic;
		color: rgb(var(--accent));
		position: relative;
	}
	.lede {
		max-width: 620px;
		font-size: 1.1rem;
		color: rgb(var(--ink-soft));
		margin: 1.25rem 0 2rem;
	}
	.actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }

	.scroll-hint {
		position: absolute; bottom: 1rem; left: 0;
		display: flex; align-items: center; gap: 0.8rem;
		font-size: 0.72rem; letter-spacing: 0.25em; color: rgb(var(--muted));
	}
	.scroll-hint .line {
		display: inline-block; width: 60px; height: 1px;
		background: rgb(var(--muted));
		animation: lineSlide 2.4s ease-in-out infinite;
		transform-origin: left center;
	}
	@keyframes lineSlide {
		0%,100% { transform: scaleX(0.4); opacity: 0.4; }
		50% { transform: scaleX(1); opacity: 1; }
	}

	.section-header {
		display: flex; align-items: flex-end; justify-content: space-between;
		gap: 1rem; margin-bottom: 2.5rem;
	}
	.section-header h2 { margin: 0; }

	.post-list { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.post-card {
		display: flex; flex-direction: column;
		padding: 1.75rem 1.6rem 1.5rem;
		min-height: 280px;
		color: rgb(var(--ink));
	}
	.post-card .num {
		font-family: var(--font-mono);
		font-size: 0.72rem; color: rgb(var(--muted));
		letter-spacing: 0.1em;
	}
	.post-meta { font-size: 0.8rem; color: rgb(var(--muted)); margin-top: 1.5rem; }
	.post-title {
		margin: 0.6rem 0 0.8rem;
		font-size: 1.35rem; line-height: 1.25;
	}
	.post-desc {
		font-size: 0.92rem; color: rgb(var(--ink-soft));
		line-height: 1.65; margin: 0; flex: 1;
	}
	.read {
		margin-top: 1.4rem;
		font-size: 0.85rem; font-weight: 500; color: rgb(var(--ink));
		display: inline-flex; align-items: center; gap: 0.35rem;
	}
	.post-card:hover .read .arrow,
	.nav-card:hover .arrow { transform: translateX(6px); }
	.read .arrow, .nav-card .arrow { display: inline-block; transition: transform 0.4s var(--ease); }

	.nav-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.nav-card {
		padding: 1.75rem 1.6rem;
		color: rgb(var(--ink));
		min-height: 220px;
		display: flex; flex-direction: column;
	}
	.big-num {
		font-family: var(--font-display);
		font-size: 3rem; line-height: 1;
		color: rgb(var(--accent));
		opacity: 0.85;
		margin-bottom: 1.2rem;
	}
	.nav-card h3 { margin: 0 0 0.4rem; font-size: 1.4rem; }
	.nav-card p { margin: 0 0 1.2rem; font-size: 0.92rem; color: rgb(var(--ink-soft)); flex: 1; }

	@media (max-width: 820px) {
		.post-list, .nav-grid { grid-template-columns: 1fr; }
		.section-header { flex-direction: column; align-items: flex-start; }
		.scroll-hint { display: none; }
	}
</style>
