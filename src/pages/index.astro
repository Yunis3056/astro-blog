---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Effects from '../components/Effects.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { SITE_DESCRIPTION, SITE_TITLE } from '../consts';
import {
	entriesForSeries,
	getPublicSeries,
	getPublicTopics,
	getSearchableEntries,
	hrefForEntry,
	labelForEntry,
	topicUsage,
} from '../lib/content';

const latestPosts = (await getCollection('blog'))
	.filter((post) => !post.data.draft)
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf())
	.slice(0, 3);
const [topics, series, entries] = await Promise.all([
	getPublicTopics(),
	getPublicSeries(),
	getSearchableEntries(),
]);
const usage = topicUsage(entries);
const featuredEntries = entries.filter((entry) => entry.data.featured).slice(0, 4);
const featuredTopics = topics.filter((topic) => topic.data.featured).slice(0, 4);
const featuredSeries = series.filter((item) => item.data.featured).slice(0, 2);

---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
	</head>
	<body>
		<Effects />
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow reveal">个人空间 · 自 2025</p>
				<h1 class="reveal" style="--reveal-delay: 100ms">
					把经验写成<br>
					可回到的<em>系统</em>。
				</h1>
				<p class="lede reveal" style="--reveal-delay: 220ms">
					{SITE_DESCRIPTION} 4.0 把文章、笔记和项目串成专题与系列，让旧内容能被重新找到、继续阅读和持续更新。
				</p>
				<div class="actions reveal" style="--reveal-delay: 340ms">
					<a href="/topics" class="btn">
						浏览专题
						<span class="arrow">→</span>
					</a>
					<a href="/series" class="btn ghost">阅读系列</a>
				</div>
				<div class="stats reveal" style="--reveal-delay: 420ms">
					<span><strong>{topics.length}</strong> 个专题</span>
					<span><strong>{series.length}</strong> 条系列</span>
					<span><strong>{entries.length}</strong> 个内容节点</span>
				</div>
				<div class="scroll-hint" aria-hidden="true">
					<span>SCROLL</span>
					<span class="line"></span>
				</div>
			</section>

			<section class="topics reveal">
				<header class="section-header">
					<div>
						<p class="eyebrow">专题</p>
						<h2>知识地图</h2>
					</div>
					<a href="/topics" class="link-arrow">查看全部 <span class="arrow">→</span></a>
				</header>
				<div class="topic-grid">
					{featuredTopics.map((topic, i) => (
						<a class="topic-card spotlight reveal" href={`/topics/${topic.id}/`} style={`--reveal-delay: ${i * 100}ms`}>
							<span class="num">{String(i + 1).padStart(2, '0')}</span>
							<h3>{topic.data.title}</h3>
							<p>{topic.data.description}</p>
							<span class="read">{usage.get(topic.id) ?? 0} 条内容 <span class="arrow">→</span></span>
						</a>
					))}
				</div>
			</section>

			<section class="featured reveal">
				<header class="section-header">
					<div>
						<p class="eyebrow">精选</p>
						<h2>优先阅读</h2>
					</div>
				</header>
				<div class="feature-list">
					{featuredEntries.map((entry, i) => (
						<a class="feature-row reveal" href={hrefForEntry(entry)} style={`--reveal-delay: ${i * 80}ms`}>
							<span class="type">{labelForEntry(entry)}</span>
							<div>
								<h3>{entry.data.title}</h3>
								<p>{entry.data.description}</p>
							</div>
							<span class="row-arrow">→</span>
						</a>
					))}
				</div>
			</section>

			<section class="series reveal">
				<header class="section-header">
					<div>
						<p class="eyebrow">路径</p>
						<h2>连续阅读</h2>
					</div>
					<a href="/series" class="link-arrow">全部系列 <span class="arrow">→</span></a>
				</header>
				<div class="series-grid">
					{featuredSeries.map((item, i) => (
						<a class="series-card spotlight reveal" href={`/series/${item.id}/`} style={`--reveal-delay: ${i * 110}ms`}>
							<h3>{item.data.title}</h3>
							<p>{item.data.description}</p>
							<span class="read">{entriesForSeries(entries, item.id).length} 个节点 <span class="arrow">→</span></span>
						</a>
					))}
				</div>
			</section>

			<section class="latest reveal">
				<header class="section-header">
					<div>
						<p class="eyebrow">最近</p>
						<h2>近期写作</h2>
					</div>
					<a href="/blog" class="link-arrow">查看全部 <span class="arrow">→</span></a>
				</header>
				<div class="post-list">
					{latestPosts.map((post, i) => (
						<a class="post-card spotlight reveal" href={`/blog/${post.id}/`} style={`--reveal-delay: ${i * 120}ms`}>
							<div class="num">{String(i + 1).padStart(2, '0')}</div>
							<div class="post-meta"><FormattedDate date={post.data.pubDate} /></div>
							<h3 class="post-title">{post.data.title}</h3>
							<p class="post-desc">{post.data.description}</p>
							<span class="read">阅读 <span class="arrow">→</span></span>
						</a>
					))}
				</div>
			</section>

		</main>
		<Footer />
	</body>
</html>

<style>
	.hero {
		min-height: 75vh;
		display: flex; flex-direction: column; justify-content: center;
		padding: 4rem 0 6rem;
		position: relative;
	}
	.hero h1 em {
		font-style: italic;
		color: rgb(var(--accent));
		position: relative;
	}
	.lede {
		max-width: 620px;
		font-size: 1.1rem;
		color: rgb(var(--ink-soft));
		margin: 1.25rem 0 2rem;
	}
	.actions { display: flex; flex-wrap: wrap; gap: 0.8rem; }
	.stats {
		display: flex;
		flex-wrap: wrap;
		gap: 0.6rem 1rem;
		margin-top: 1.2rem;
		color: rgb(var(--muted));
		font-size: 0.85rem;
	}
	.stats strong {
		font-family: var(--font-mono);
		color: rgb(var(--ink));
	}

	.scroll-hint {
		position: absolute; bottom: 1rem; left: 0;
		display: flex; align-items: center; gap: 0.8rem;
		font-size: 0.72rem; letter-spacing: 0.25em; color: rgb(var(--muted));
	}
	.scroll-hint .line {
		display: inline-block; width: 60px; height: 1px;
		background: rgb(var(--muted));
		animation: lineSlide 2.4s ease-in-out infinite;
		transform-origin: left center;
	}
	@keyframes lineSlide {
		0%,100% { transform: scaleX(0.4); opacity: 0.4; }
		50% { transform: scaleX(1); opacity: 1; }
	}

	.section-header {
		display: flex; align-items: flex-end; justify-content: space-between;
		gap: 1rem; margin-bottom: 2.5rem;
	}
	.section-header h2 { margin: 0; }

	.post-list, .topic-grid, .series-grid { display: grid; grid-template-columns: repeat(3, 1fr); gap: 1.25rem; }
	.topic-grid { grid-template-columns: repeat(4, 1fr); }
	.series-grid { grid-template-columns: repeat(2, 1fr); }
	.post-card {
		display: flex; flex-direction: column;
		padding: 1.75rem 1.6rem 1.5rem;
		min-height: 280px;
		color: rgb(var(--ink));
	}
	.topic-card,
	.series-card {
		display: flex;
		flex-direction: column;
		min-height: 230px;
		padding: 1.45rem;
		color: rgb(var(--ink));
	}
	.series-card { min-height: 210px; }
	.post-card .num {
		font-family: var(--font-mono);
		font-size: 0.72rem; color: rgb(var(--muted));
		letter-spacing: 0.1em;
	}
	.topic-card .num {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgb(var(--accent));
		letter-spacing: 0.1em;
	}
	.post-meta { font-size: 0.8rem; color: rgb(var(--muted)); margin-top: 1.5rem; }
	.post-title {
		margin: 0.6rem 0 0.8rem;
		font-size: 1.35rem; line-height: 1.25;
	}
	.topic-card h3,
	.series-card h3 {
		margin: 1rem 0 0.65rem;
		font-size: 1.28rem;
	}
	.series-card h3 { margin-top: 0; }
	.post-desc {
		font-size: 0.92rem; color: rgb(var(--ink-soft));
		line-height: 1.65; margin: 0; flex: 1;
	}
	.topic-card p,
	.series-card p {
		font-size: 0.9rem;
		color: rgb(var(--ink-soft));
		line-height: 1.6;
		margin: 0;
		flex: 1;
	}
	.read {
		margin-top: 1.4rem;
		font-size: 0.85rem; font-weight: 500; color: rgb(var(--ink));
		display: inline-flex; align-items: center; gap: 0.35rem;
	}
	.post-card:hover .read .arrow,
	.topic-card:hover .arrow,
	.series-card:hover .arrow,
	.feature-row:hover .row-arrow { transform: translateX(6px); }
	.read .arrow, .row-arrow { display: inline-block; transition: transform 0.4s var(--ease); }

	.feature-list {
		display: flex;
		flex-direction: column;
		border-top: 1px solid rgb(var(--line));
	}
	.feature-row {
		display: grid;
		grid-template-columns: 90px minmax(0, 1fr) 32px;
		gap: 1.2rem;
		align-items: center;
		padding: 1.25rem 0.4rem;
		border-bottom: 1px solid rgb(var(--line));
		color: rgb(var(--ink));
	}
	.feature-row .type {
		font-family: var(--font-mono);
		font-size: 0.72rem;
		color: rgb(var(--muted));
	}
	.feature-row h3 {
		margin: 0 0 0.35rem;
		font-size: 1.2rem;
		transition: color 0.3s var(--ease);
	}
	.feature-row:hover h3 { color: rgb(var(--accent)); }
	.feature-row p { margin: 0; font-size: 0.9rem; color: rgb(var(--ink-soft)); }
	.row-arrow { color: rgb(var(--muted)); text-align: right; }

	@media (max-width: 820px) {
		.post-list, .topic-grid, .series-grid { grid-template-columns: 1fr; }
		.section-header { flex-direction: column; align-items: flex-start; }
		.scroll-hint { display: none; }
		.feature-row { grid-template-columns: 1fr; gap: 0.45rem; }
		.row-arrow { display: none; }
	}
</style>
