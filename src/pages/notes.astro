---
import BaseHead from '../components/BaseHead.astro';
import Effects from '../components/Effects.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import { getPublicNotes, getSiteSettings } from '../lib/content';

export const prerender = true;

const settings = await getSiteSettings();
const notes = await getPublicNotes();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`笔记 · ${settings.title}`} description="Yunis 的短笔记和待办想法。" siteTitle={settings.title} defaultOgImage={settings.defaultOgImage} />
	</head>
	<body>
		<Effects />
		<Header siteTitle={settings.title} />
		<main>
			<section class="hero">
				<p class="eyebrow reveal">碎片</p>
				<h1 class="reveal" style="--reveal-delay: 100ms"><em>笔记</em>本</h1>
				<p class="lede reveal" style="--reveal-delay: 200ms">还没整理成长文的短记录：想法、资料链接、待办事项、写作线索。每条笔记都可以单独打开。</p>
			</section>

			<section>
				<ul class="note-list">
					{notes.map((note, i) => (
						<li class="reveal" style={`--reveal-delay: ${i * 100}ms`}>
							<a class="note spotlight" href={`/notes/${note.id}/`}>
								<span class="ix">#{String(i + 1).padStart(2, '0')}</span>
								<h2>{note.data.title}</h2>
								<p>{note.data.description}</p>
								<div class="meta">
									<FormattedDate date={note.data.pubDate} />
									<span>阅读笔记 <span class="arrow">→</span></span>
								</div>
							</a>
						</li>
					))}
				</ul>
			</section>
		</main>
		<Footer siteTitle={settings.title} />
	</body>
</html>

<style>
	.hero { padding: 2rem 0 4rem; max-width: 720px; }
	.hero h1 em { font-style: italic; color: rgb(var(--accent)); }
	.lede { font-size: 1.05rem; color: rgb(var(--ink-soft)); }
	.note-list {
		display: grid;
		grid-template-columns: repeat(2, 1fr);
		gap: 1.25rem;
		list-style: none; padding: 0; margin: 0;
	}
	.note {
		position: relative;
		padding: 1.5rem 1.6rem 1.6rem;
		display: flex; flex-direction: column;
		min-height: 210px;
		color: rgb(var(--ink));
	}
	.ix { font-family: var(--font-mono); font-size: 0.72rem; letter-spacing: 0.12em; color: rgb(var(--accent)); }
	.note h2 { margin: 0.8rem 0 0.65rem; font-size: 1.35rem; transition: color 0.3s var(--ease); }
	.note:hover h2 { color: rgb(var(--accent)); }
	.note p { margin: 0; font-family: var(--font-display); font-size: 1.08rem; line-height: 1.55; color: rgb(var(--ink)); flex: 1; }
	.meta {
		display: flex; align-items: center; justify-content: space-between; gap: 1rem;
		margin-top: 1.2rem;
		font-size: 0.78rem; color: rgb(var(--muted));
	}
	.meta .arrow { display: inline-block; transition: transform 0.3s var(--ease); }
	.note:hover .meta .arrow { transform: translateX(6px); }
	@media (max-width: 720px) {
		.note-list { grid-template-columns: 1fr; }
		.meta { align-items: flex-start; flex-direction: column; gap: 0.4rem; }
	}
</style>
