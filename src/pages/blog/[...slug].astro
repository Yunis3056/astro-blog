---
import { type CollectionEntry, getCollection, render } from 'astro:content';
import BlogPost from '../../layouts/BlogPost.astro';
import {
	getSearchableEntries,
	getSeriesMap,
	getTopicMap,
	relatedPostsFor,
	entriesForSeries,
} from '../../lib/content';

export async function getStaticPaths() {
	const posts = (await getCollection('blog'))
		.filter((p) => !p.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: i + 1 < posts.length ? posts[i + 1] : null, // 更早的
			next: i - 1 >= 0 ? posts[i - 1] : null,           // 更新的
		},
	}));
}

const { post, prev, next } = Astro.props as {
	post: CollectionEntry<'blog'>;
	prev: CollectionEntry<'blog'> | null;
	next: CollectionEntry<'blog'> | null;
};
const { Content, headings } = await render(post);
const [posts, entries, topicMap, seriesMap] = await Promise.all([
	(await getCollection('blog'))
		.filter((p) => !p.data.draft)
		.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf()),
	getSearchableEntries(),
	getTopicMap(),
	getSeriesMap(),
]);
const topicEntries = post.data.topics
	.map((topic) => topicMap.get(topic))
	.filter((topic): topic is CollectionEntry<'topics'> => Boolean(topic));
const seriesEntry = post.data.series ? seriesMap.get(post.data.series.slug) ?? null : null;
const seriesItems = post.data.series ? entriesForSeries(entries, post.data.series.slug) : [];
const relatedPosts = relatedPostsFor(post, posts);
---

<BlogPost
	{...post.data}
	slug={post.id}
	headings={headings}
	body={post.body ?? ''}
	prev={prev}
	next={next}
	topicEntries={topicEntries}
	seriesEntry={seriesEntry}
	seriesItems={seriesItems}
	relatedPosts={relatedPosts}
>
	<Content />
</BlogPost>
