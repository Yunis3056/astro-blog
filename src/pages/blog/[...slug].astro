---
import BlogPost from '../../layouts/BlogPost.astro';
import {
	entriesForSeries,
	getPublicBlogPosts,
	getSearchableEntries,
	getSiteSettings,
	relatedPostsFor,
	type BlogEntry,
} from '../../lib/content';
import { headingsFromPortableText } from '../../lib/sanity/portable-text';

export const prerender = true;

export async function getStaticPaths() {
	const posts = await getPublicBlogPosts();
	return posts.map((post, i) => ({
		params: { slug: post.id },
		props: {
			post,
			prev: i + 1 < posts.length ? posts[i + 1] : null,
			next: i - 1 >= 0 ? posts[i - 1] : null,
		},
	}));
}

const { post, prev, next } = Astro.props as {
	post: BlogEntry;
	prev: BlogEntry | null;
	next: BlogEntry | null;
};
const [posts, entries, siteSettings] = await Promise.all([getPublicBlogPosts(), getSearchableEntries(), getSiteSettings()]);
const headings = headingsFromPortableText(post.data.body);
const seriesItems = post.data.series ? entriesForSeries(entries, post.data.series.slug) : [];
const relatedPosts = relatedPostsFor(post, posts);
---

<BlogPost
	{...post.data}
	slug={post.id}
	headings={headings}
	body={post.data.body}
	bodyText={post.data.bodyText}
	prev={prev}
	next={next}
	topicEntries={post.data.topicEntries}
	seriesEntry={post.data.seriesEntry}
	seriesItems={seriesItems}
	relatedPosts={relatedPosts}
	siteSettings={siteSettings}
/>
