---
import BaseHead from '../../components/BaseHead.astro';
import Effects from '../../components/Effects.astro';
import Footer from '../../components/Footer.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import Header from '../../components/Header.astro';
import { getPublicBlogPosts, getSiteSettings } from '../../lib/content';
import { sanityImageAlt, sanityImageUrl } from '../../lib/sanity/image';

export const prerender = true;

const settings = await getSiteSettings();
const posts = await getPublicBlogPosts();
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`文章 · ${settings.title}`} description="Yunis 的博客文章归档。" siteTitle={settings.title} defaultOgImage={settings.defaultOgImage} />
	</head>
	<body>
		<Effects />
		<Header siteTitle={settings.title} />
		<main>
			<section class="page-heading">
				<p class="eyebrow reveal">归档</p>
				<h1 class="reveal" style="--reveal-delay: 100ms">所有<em>文章</em></h1>
				<p class="lede reveal" style="--reveal-delay: 200ms">完整的写作记录，按时间倒序排列。从最新的尝试到早期的构思。</p>
			</section>

			<section>
				<ul class="post-feed">
					{posts.map((post, i) => {
						const thumb = post.data.heroImage ? sanityImageUrl(post.data.heroImage, {width: 420, height: 260, quality: 78}) : '';
						return (
							<li class="reveal" style={`--reveal-delay: ${i * 80}ms`}>
								<a class="row" href={`/blog/${post.id}/`}>
									<div class="row-meta">
										<span class="num">{String(i + 1).padStart(2, '0')}</span>
										<FormattedDate date={post.data.pubDate} />
									</div>
									<div class="row-main">
										<h2 class="row-title">{post.data.title}</h2>
										<p class="row-desc">{post.data.description}</p>
										{post.data.tags.length > 0 && (
											<div class="row-tags">{post.data.tags.map((tag) => <span class="row-chip">{tag}</span>)}</div>
										)}
									</div>
									{thumb && (
										<div class="row-thumb">
											<img width="400" height="260" src={thumb} alt={sanityImageAlt(post.data.heroImage, post.data.title)} loading="lazy" decoding="async" />
										</div>
									)}
									<span class="row-arrow" aria-hidden="true">→</span>
								</a>
							</li>
						);
					})}
				</ul>
			</section>
		</main>
		<Footer siteTitle={settings.title} />
	</body>
</html>

<style>
	.page-heading { padding: 2rem 0 4rem; }
	.page-heading h1 em { font-style: italic; color: rgb(var(--accent)); }
	.lede { max-width: 600px; color: rgb(var(--ink-soft)); font-size: 1.05rem; }
	.post-feed { list-style: none; margin: 0; padding: 0; }
	.post-feed li { border-top: 1px solid rgb(var(--line)); }
	.post-feed li:last-child { border-bottom: 1px solid rgb(var(--line)); }
	.row {
		display: grid;
		grid-template-columns: 160px 1fr 200px 32px;
		gap: 2rem; align-items: center;
		padding: 2rem 0.5rem;
		color: rgb(var(--ink));
		position: relative;
		transition: padding 0.5s var(--ease), background 0.5s var(--ease);
	}
	.row::before {
		content: ""; position: absolute; inset: 0;
		background: linear-gradient(90deg, transparent, rgba(var(--accent), 0.05), transparent);
		opacity: 0; transition: opacity 0.5s var(--ease);
		pointer-events: none;
	}
	.row:hover::before { opacity: 1; }
	.row:hover { padding-left: 1.5rem; }
	.row:hover .row-arrow { transform: translateX(6px); color: rgb(var(--accent)); }
	.row:hover .row-title { color: rgb(var(--accent)); }
	.row:hover .row-thumb img { transform: scale(1.05); }
	.row-meta { display: flex; flex-direction: column; gap: 0.4rem; color: rgb(var(--muted)); font-size: 0.85rem; }
	.num { font-family: var(--font-mono); font-size: 0.75rem; letter-spacing: 0.1em; }
	.row-title { margin: 0 0 0.35rem; font-size: 1.6rem; line-height: 1.2; transition: color 0.4s var(--ease); }
	.row-desc { margin: 0; color: rgb(var(--ink-soft)); font-size: 0.95rem; }
	.row-thumb { overflow: hidden; border-radius: var(--radius-sm); }
	.row-thumb img { display: block; width: 100%; height: 130px; object-fit: cover; transition: transform 0.7s var(--ease-out); }
	.row-arrow { font-size: 1.2rem; color: rgb(var(--muted)); transition: transform 0.4s var(--ease), color 0.4s var(--ease); text-align: right; }
	.row-tags { display: flex; flex-wrap: wrap; gap: 0.35rem; margin-top: 0.7rem; }
	.row-chip {
		display: inline-flex; align-items: center;
		min-height: 22px; padding: 0.1rem 0.5rem;
		font-size: 0.7rem; line-height: 1;
		border-radius: 6px;
		color: rgb(var(--ink-soft));
		background: rgba(var(--bg-soft), 0.75);
		border: 1px solid rgba(var(--line), 0.95);
	}
	@media (max-width: 820px) {
		.row { grid-template-columns: 1fr; gap: 0.8rem; padding: 1.5rem 0; }
		.row:hover { padding-left: 0; }
		.row-thumb { display: none; }
		.row-arrow { display: none; }
		.row-meta { flex-direction: row; gap: 1rem; }
	}
</style>
