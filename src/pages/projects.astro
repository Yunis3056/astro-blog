---
import { getCollection } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Effects from '../components/Effects.astro';
import Footer from '../components/Footer.astro';
import Header from '../components/Header.astro';
import { SITE_TITLE } from '../consts';

const statusLabels = {
	active: '进行中',
	planned: '规划中',
	idle: '待启动',
	done: '已完成',
} as const;

const projects = (await getCollection('projects'))
	.filter((p) => !p.data.draft)
	.sort((a, b) => a.data.order - b.data.order || a.data.title.localeCompare(b.data.title, 'zh-CN'));
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`项目 — ${SITE_TITLE}`} description="Yunis 的项目记录和计划。" />
	</head>
	<body>
		<Effects />
		<Header />
		<main>
			<section class="hero">
				<p class="eyebrow reveal">作品</p>
				<h1 class="reveal" style="--reveal-delay: 100ms">在做与<em>计划中</em>。</h1>
				<p class="lede reveal" style="--reveal-delay: 200ms">记录项目的目标、状态和技术栈。每个项目都可以点进去看进度、动机和后续计划。</p>
			</section>

			<section class="project-list">
				{projects.map((project, i) => (
					<a class="project spotlight reveal" href={`/projects/${project.id}/`} style={`--reveal-delay: ${i * 100}ms`}>
						<div class="head">
							<h2>{project.data.title}</h2>
							<span class={`status status-${project.data.status}`}>
								<span class="dot"></span>{statusLabels[project.data.status]}
							</span>
						</div>
						<p class="desc">{project.data.description}</p>
						<p class="stack">{project.data.stack.join(' · ')}</p>
						<span class="open">查看项目 <span class="arrow">→</span></span>
					</a>
				))}
			</section>
		</main>
		<Footer />
	</body>
</html>

<style>
	.hero { padding: 2rem 0 4rem; max-width: 720px; }
	.hero h1 em { font-style: italic; color: rgb(var(--accent)); }
	.lede { font-size: 1.05rem; color: rgb(var(--ink-soft)); }

	.project-list { display: grid; gap: 1.25rem; }
	.project {
		display: block;
		padding: 1.75rem 1.8rem;
		color: rgb(var(--ink));
	}
	.head {
		display: flex; justify-content: space-between; align-items: center;
		gap: 1rem; margin-bottom: 0.6rem;
	}
	.head h2 { margin: 0; font-size: 1.55rem; transition: color 0.3s var(--ease); }
	.project:hover h2 { color: rgb(var(--accent)); }

	.status {
		display: inline-flex; align-items: center; gap: 0.45rem;
		padding: 0.3rem 0.7rem;
		font-size: 0.75rem; font-weight: 500; letter-spacing: 0.04em;
		border-radius: 999px;
		border: 1px solid rgb(var(--line));
		background: rgba(var(--bg), 0.6);
		color: rgb(var(--ink-soft));
		white-space: nowrap;
	}
	.status .dot { width: 6px; height: 6px; border-radius: 50%; background: rgb(var(--muted)); }
	.status-active .dot { background: rgb(var(--accent)); box-shadow: 0 0 8px rgba(var(--accent), 0.6); animation: pulse 2.4s ease-in-out infinite; }
	.status-planned .dot { background: #ddb44d; }
	.status-done .dot { background: #4f9f6f; }

	.desc { margin: 0 0 1rem; color: rgb(var(--ink-soft)); }
	.stack {
		margin: 0;
		font-family: var(--font-mono);
		font-size: 0.78rem; letter-spacing: 0.06em;
		color: rgb(var(--muted));
		text-transform: uppercase;
	}
	.open {
		display: inline-flex; align-items: center; gap: 0.35rem;
		margin-top: 1.2rem;
		font-size: 0.88rem; font-weight: 600;
		color: rgb(var(--ink));
	}
	.open .arrow { display: inline-block; transition: transform 0.3s var(--ease); }
	.project:hover .open .arrow { transform: translateX(6px); }

	@media (max-width: 720px) {
		.head { flex-direction: column; align-items: flex-start; gap: 0.4rem; }
	}
</style>
