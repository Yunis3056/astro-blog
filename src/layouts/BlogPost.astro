---
import { Image } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import BaseHead from '../components/BaseHead.astro';
import Comments from '../components/Comments.astro';
import Effects from '../components/Effects.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Header from '../components/Header.astro';
import SearchMeta from '../components/SearchMeta.astro';
import TagList from '../components/TagList.astro';
import { hrefForEntry, labelForEntry, type SearchableEntry } from '../lib/content';

interface Heading { depth: number; slug: string; text: string; }

type Props = CollectionEntry<'blog'>['data'] & {
	slug?: string;
	headings?: Heading[];
	body?: string;
	prev?: CollectionEntry<'blog'> | null;
	next?: CollectionEntry<'blog'> | null;
	topicEntries?: CollectionEntry<'topics'>[];
	seriesEntry?: CollectionEntry<'series'> | null;
	seriesItems?: SearchableEntry[];
	relatedPosts?: CollectionEntry<'blog'>[];
};

const {
	title,
	description,
	pubDate,
	updatedDate,
	heroImage,
	tags = [],
	canonicalURL,
	slug = Astro.params.slug || '',
	headings = [],
	body = '',
	prev = null,
	next = null,
	topicEntries = [],
	seriesEntry = null,
	seriesItems = [],
	relatedPosts = [],
} = Astro.props;

// 只取 h2 / h3
const toc = headings.filter((h) => h.depth === 2 || h.depth === 3);

// 阅读时长：中文按字符计，英文按词计，约 350 字符/分钟
const cn = (body.match(/[一-龥]/g) || []).length;
const en = (body.replace(/[一-龥]/g, ' ').trim().split(/\s+/).filter(Boolean)).length;
const readingMin = Math.max(1, Math.round(cn / 350 + en / 220));
const currentHref = `/blog/${slug}/`;
const seriesIndex = seriesItems.findIndex((item) => hrefForEntry(item) === currentHref);
const topicNames = topicEntries.map((topic) => topic.data.title);
---

<html lang="zh-CN">
	<head>
		<BaseHead title={title} description={description} ogImage={`/og/${slug}.png`} canonicalURL={canonicalURL} />
	</head>
	<body>
		<div class="progress-bar" id="progressBar" aria-hidden="true"></div>
		<Effects />
		<Header />
		<main class="post-main">
			<article class="post-grid">
				<div class="post-body">
					<div class="reveal">
						<div class="post-meta">
							<FormattedDate date={pubDate} />
							<span class="sep">·</span>
							<span>约 {readingMin} 分钟阅读</span>
							{updatedDate && (<><span class="sep">·</span><span class="updated">更新于 <FormattedDate date={updatedDate} /></span></>)}
						</div>
						<h1 class="post-title" data-pagefind-meta="title">{title}</h1>
						<p class="post-desc">{description}</p>
						<SearchMeta type="文章" date={pubDate} topics={topicNames} tags={tags} series={seriesEntry?.data.title} />
						{topicEntries.length > 0 && (
							<div class="post-topics">
								{topicEntries.map((topic) => <a href={`/topics/${topic.id}/`}>{topic.data.title}</a>)}
							</div>
						)}
						{tags.length > 0 && <div class="post-tags"><TagList tags={tags} /></div>}
					</div>

					{heroImage && (
						<div class="hero-image reveal">
							<Image width={1280} height={640} src={heroImage} alt="" />
						</div>
					)}

					{seriesEntry && seriesItems.length > 0 && (
						<section class="series-panel reveal" aria-labelledby="series-title">
							<div class="series-head">
								<p class="eyebrow small">系列</p>
								<h2 id="series-title">{seriesEntry.data.title}</h2>
								<p>{seriesEntry.data.description}</p>
							</div>
							<ol>
								{seriesItems.map((item, index) => (
									<li class:list={{ active: index === seriesIndex }}>
										<a href={hrefForEntry(item)}>
											<span>{String(index + 1).padStart(2, '0')}</span>
											<strong>{item.data.title}</strong>
											<em>{labelForEntry(item)}</em>
										</a>
									</li>
								))}
							</ol>
						</section>
					)}

					<div class="prose reveal" id="postProse" data-pagefind-body>
						<slot />
					</div>

					{relatedPosts.length > 0 && (
						<section class="related-posts reveal" aria-labelledby="related-title">
							<p class="eyebrow small">继续阅读</p>
							<h2 id="related-title">和这篇相关的文章</h2>
							<div class="related-grid">
								{relatedPosts.map((post) => (
									<a class="related-card" href={`/blog/${post.id}/`}>
										<span><FormattedDate date={post.data.pubDate} /></span>
										<strong>{post.data.title}</strong>
										<p>{post.data.description}</p>
									</a>
								))}
							</div>
						</section>
					)}

					{(prev || next) && (
						<nav class="post-nav" aria-label="文章导航">
							{prev && (
								<a class="nav-card prev" href={`/blog/${prev.id}/`}>
									<span class="dir"><span class="arrow">←</span> 上一篇</span>
									<span class="t">{prev.data.title}</span>
								</a>
							)}
							{next && (
								<a class="nav-card next" href={`/blog/${next.id}/`}>
									<span class="dir">下一篇 <span class="arrow">→</span></span>
									<span class="t">{next.data.title}</span>
								</a>
							)}
						</nav>
					)}
					<Comments />
					<a class="back magnetic" href="/blog" data-magnetic="0.25">
						<span class="arrow">←</span> 返回文章列表
					</a>
				</div>

				{toc.length > 0 && (
					<aside class="toc-aside" aria-label="目录">
						<div class="toc-sticky">
							<p class="toc-label">目录</p>
							<nav class="toc-nav" id="tocNav">
								<ol>
									{toc.map((h) => (
										<li class={`depth-${h.depth}`}>
											<a href={`#${h.slug}`} data-toc-link={h.slug}>{h.text}</a>
										</li>
									))}
								</ol>
							</nav>
						</div>
					</aside>
				)}
			</article>
		</main>
		<Footer />

		<script is:inline>
			function __postInit(){
				// reading progress bar
				if (window.__postScrollHandler) {
					removeEventListener('scroll', window.__postScrollHandler);
				}
				const onScroll = () => {
					const bar = document.getElementById('progressBar');
					if (!bar) return;
					const h = document.documentElement;
					const top = h.scrollTop || document.body.scrollTop;
					const max = (h.scrollHeight - h.clientHeight) || 1;
					bar.style.transform = `scaleX(${Math.min(1, Math.max(0, top / max))})`;
				};
				window.__postScrollHandler = onScroll;
				addEventListener('scroll', onScroll, { passive: true });
				onScroll();

				// TOC: scroll-spy + smooth click
				if (window.__postTocObserver) {
					window.__postTocObserver.disconnect();
				}
				const nav = document.getElementById('tocNav');
				if (!nav) return;
				if (nav.dataset.tocBound) return;
				nav.dataset.tocBound = '1';
				const links = Array.from(nav.querySelectorAll('a[data-toc-link]'));
				const map = new Map();
				links.forEach((a) => {
					const id = a.getAttribute('data-toc-link');
					const el = document.getElementById(id);
					if (el) map.set(el, a);
				});

				let current = null;
				const setActive = (a) => {
					if (current === a) return;
					if (current) current.classList.remove('active');
					if (a) a.classList.add('active');
					current = a;
				};

				if ('IntersectionObserver' in window) {
					const io = new IntersectionObserver((entries) => {
						// 选最靠上的相交标题
						const visible = entries.filter((e) => e.isIntersecting)
							.sort((a, b) => a.boundingClientRect.top - b.boundingClientRect.top);
						if (visible[0]) {
							const link = map.get(visible[0].target);
							if (link) setActive(link);
						}
					}, { rootMargin: '-72px 0px -70% 0px', threshold: [0, 1] });
					map.forEach((_, el) => io.observe(el));
					window.__postTocObserver = io;
				}

				// 平滑跳转 + URL 同步
				links.forEach((a) => {
					a.addEventListener('click', (e) => {
						const id = a.getAttribute('data-toc-link');
						const el = document.getElementById(id);
						if (!el) return;
						e.preventDefault();
						const top = el.getBoundingClientRect().top + window.scrollY - 80;
						window.scrollTo({ top, behavior: 'smooth' });
						history.replaceState(null, '', `#${id}`);
						setActive(a);
					});
				});
			}
			if (document.readyState === "loading") document.addEventListener("DOMContentLoaded", __postInit); else __postInit();
			document.addEventListener("astro:page-load", __postInit);
		</script>

		<style>
			.progress-bar {
				position: fixed; top: 0; left: 0; right: 0;
				height: 2px; z-index: 200;
				background: rgb(var(--accent));
				transform: scaleX(0); transform-origin: 0 50%;
				transition: transform 0.05s linear;
			}

			.post-main { max-width: var(--container); padding-top: 4rem; }

			.post-grid {
				display: grid;
				grid-template-columns: minmax(0, 1fr) 240px;
				gap: 4rem;
				align-items: start;
			}
			.post-body { max-width: 720px; min-width: 0; }

			.post-meta {
				display: flex; align-items: center; gap: 0.7rem;
				font-size: 0.85rem; color: rgb(var(--muted));
				letter-spacing: 0.05em; margin-bottom: 1.2rem;
			}
			.sep { opacity: 0.5; }
			.post-title {
				font-size: clamp(2rem, 4.5vw, 3.4rem);
				line-height: 1.1; letter-spacing: -0.03em;
				margin: 0 0 1rem;
			}
			.post-desc {
				font-family: var(--font-display);
				font-size: 1.25rem; line-height: 1.55;
				color: rgb(var(--ink-soft));
				font-style: italic;
				margin: 0 0 1.5rem;
			}
			.post-topics {
				display: flex;
				flex-wrap: wrap;
				gap: 0.5rem;
				margin-bottom: 1rem;
			}
			.post-topics a {
				display: inline-flex;
				align-items: center;
				min-height: 28px;
				padding: 0.16rem 0.7rem;
				border: 1px solid rgba(var(--accent), 0.28);
				border-radius: 999px;
				background: rgba(var(--accent), 0.08);
				color: rgb(var(--accent));
				font-size: 0.78rem;
				font-weight: 600;
			}
			.post-tags { margin: 0 0 2.5rem; padding-bottom: 2rem; border-bottom: 1px solid rgb(var(--line)); }

			.hero-image {
				margin: 0 0 3rem;
				overflow: hidden;
				border-radius: var(--radius);
				border: 1px solid rgb(var(--line));
			}
			.hero-image :global(img) {
				display: block; width: 100%; height: auto;
				transition: transform 1s var(--ease-out);
			}
			.hero-image:hover :global(img) { transform: scale(1.02); }

			.prose { font-size: 1.05rem; scroll-margin-top: 80px; }
			.prose :global(h2),
			.prose :global(h3) { scroll-margin-top: 80px; }
			.prose :global(h2) { margin-top: 2.5rem; font-size: 1.6rem; }
			.prose :global(h3) { margin-top: 2rem; }
			.prose :global(p) { color: rgb(var(--ink-soft)); }
			.prose :global(a) {
				color: rgb(var(--ink));
				background-image: linear-gradient(rgb(var(--accent)), rgb(var(--accent)));
				background-size: 100% 1px; background-position: 0 100%;
				background-repeat: no-repeat;
				transition: background-size 0.4s var(--ease);
			}
			.prose :global(a:hover) { background-size: 100% 100%; color: rgb(var(--bg)); }

			.updated { font-style: italic; color: rgb(var(--muted)); }
			.series-panel {
				margin: 0 0 3rem;
				padding: 1.4rem;
				border: 1px solid rgb(var(--line));
				border-radius: var(--radius);
				background: rgba(var(--bg-soft), 0.65);
			}
			.series-head h2,
			.related-posts h2 {
				margin: 0 0 0.55rem;
				font-size: 1.5rem;
				letter-spacing: 0;
			}
			.series-head p { margin: 0 0 1rem; font-size: 0.92rem; }
			.eyebrow.small {
				margin-bottom: 0.6rem;
				font-size: 0.68rem;
			}
			.series-panel ol {
				list-style: none;
				display: grid;
				gap: 0.45rem;
				margin: 0;
				padding: 0;
			}
			.series-panel a {
				display: grid;
				grid-template-columns: 38px 1fr auto;
				gap: 0.8rem;
				align-items: center;
				padding: 0.65rem 0.8rem;
				border-radius: var(--radius-sm);
				color: rgb(var(--ink));
			}
			.series-panel li.active a,
			.series-panel a:hover {
				background: rgba(var(--accent), 0.1);
			}
			.series-panel span {
				font-family: var(--font-mono);
				font-size: 0.72rem;
				color: rgb(var(--muted));
			}
			.series-panel strong {
				font-size: 0.95rem;
				line-height: 1.35;
			}
			.series-panel em {
				font-style: normal;
				font-size: 0.72rem;
				color: rgb(var(--muted));
			}
			.related-posts {
				margin: 4rem 0 0;
				padding-top: 2.5rem;
				border-top: 1px solid rgb(var(--line));
			}
			.related-grid {
				display: grid;
				grid-template-columns: repeat(3, 1fr);
				gap: 0.8rem;
			}
			.related-card {
				display: flex;
				flex-direction: column;
				gap: 0.5rem;
				padding: 1rem;
				border: 1px solid rgb(var(--line));
				border-radius: var(--radius-sm);
				color: rgb(var(--ink));
				background: rgba(var(--bg-soft), 0.5);
			}
			.related-card:hover { border-color: rgba(var(--accent), 0.45); }
			.related-card span {
				font-family: var(--font-mono);
				font-size: 0.7rem;
				color: rgb(var(--muted));
			}
			.related-card strong {
				line-height: 1.35;
			}
			.related-card p {
				margin: 0;
				font-size: 0.82rem;
				line-height: 1.55;
				color: rgb(var(--ink-soft));
			}
			.back {
				display: inline-flex; align-items: center; gap: 0.4rem;
				margin: 4rem 0 0;
				font-size: 0.9rem; color: rgb(var(--ink-soft));
			}
			.back .arrow { transition: transform 0.4s var(--ease); display: inline-block; }
			.back:hover .arrow { transform: translateX(-6px); }

			/* ----- TOC sidebar ----- */
			.toc-aside {
				position: sticky;
				top: 96px;
				align-self: start;
				max-height: calc(100vh - 120px);
				overflow: hidden;
			}
			.toc-sticky {
				max-height: calc(100vh - 120px);
				overflow-y: auto;
				padding-left: 1.5rem;
				border-left: 1px solid rgb(var(--line));
			}
			.toc-label {
				margin: 0 0 1rem;
				font-size: 0.72rem; font-weight: 500;
				letter-spacing: 0.2em; text-transform: uppercase;
				color: rgb(var(--muted));
			}
			.toc-nav ol { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.2rem; }
			.toc-nav li.depth-3 { padding-left: 0.9rem; }
			.toc-nav a {
				display: block;
				padding: 0.35rem 0;
				font-size: 0.85rem;
				color: rgb(var(--muted));
				line-height: 1.4;
				border-left: 2px solid transparent;
				padding-left: 0.7rem;
				margin-left: -0.7rem;
				transition: color 0.3s var(--ease), border-color 0.3s var(--ease), padding-left 0.3s var(--ease);
			}
			.toc-nav a:hover { color: rgb(var(--ink)); }
			.toc-nav a.active {
				color: rgb(var(--accent));
				border-left-color: rgb(var(--accent));
				font-weight: 500;
			}

			@media (max-width: 1024px) {
				.post-grid { grid-template-columns: 1fr; gap: 2rem; }
				.toc-aside { order: -1; position: static; max-height: none; overflow: visible; }
				.toc-sticky {
					max-height: none; overflow: visible;
					padding: 1rem 1.2rem; border: 1px solid rgb(var(--line));
					border-radius: var(--radius-sm); border-left-width: 1px;
				}
			}
			@media (max-width: 720px) {
				.toc-aside { display: none; }
				.series-panel a { grid-template-columns: 32px 1fr; }
				.series-panel em { grid-column: 2; }
				.related-grid { grid-template-columns: 1fr; }
			}

			.post-nav {
				display: grid; grid-template-columns: 1fr 1fr; gap: 1rem;
				margin: 4rem 0 0;
			}
			.post-nav .nav-card {
				display: flex; flex-direction: column; gap: 0.5rem;
				padding: 1.1rem 1.2rem;
				border: 1px solid rgb(var(--line));
				border-radius: var(--radius-sm);
				color: rgb(var(--ink));
				transition: border-color .3s var(--ease), transform .3s var(--ease), background .3s var(--ease);
			}
			.post-nav .nav-card:hover {
				border-color: rgba(var(--ink), 0.25);
				background: rgba(var(--bg-soft), 0.6);
			}
			.post-nav .next { text-align: right; }
			.post-nav .dir {
				font-family: var(--font-mono);
				font-size: 0.72rem; letter-spacing: 0.12em;
				color: rgb(var(--muted));
				text-transform: uppercase;
			}
			.post-nav .t {
				font-family: var(--font-display);
				font-size: 1.05rem; line-height: 1.4;
				color: rgb(var(--ink));
			}
			.post-nav .nav-card:hover .t { color: rgb(var(--accent)); }
			.post-nav .arrow { display: inline-block; transition: transform .3s var(--ease); }
			.post-nav .prev:hover .arrow { transform: translateX(-4px); }
			.post-nav .next:hover .arrow { transform: translateX(4px); }
			@media (max-width: 720px) { .post-nav { grid-template-columns: 1fr; } .post-nav .next { text-align: left; } }
		</style>
	</body>
</html>
